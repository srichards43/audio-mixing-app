<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.AudioMixer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/secondaryText</item>
        <item name="colorSurface">@color/menuBar</item>
        <item name="colorSurfaceVariant">@color/secondaryMenuBar</item>
    </style>

    <style name="Theme.AudioMixer.Default" parent="Base.Theme.AudioMixer">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
    </style>

    <style name="Theme.AudioMixer.Blue" parent="Base.Theme.AudioMixer">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorSecondary">@color/secondary_blue</item>
    </style>

    <style name="Theme.AudioMixer.Green" parent="Base.Theme.AudioMixer">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorSecondary">@color/secondary_green</item>
    </style>

    <style name="Theme.AudioMixer.Orange" parent="Base.Theme.AudioMixer">
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorSecondary">@color/secondary_orange</item>
    </style>


    <style name="Theme.AudioMixer.Purple" parent="Base.Theme.AudioMixer">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorSecondary">@color/secondary_purple</item>
    </style>

    <style name="Theme.AudioMixer.Pink" parent="Base.Theme.AudioMixer">
        <item name="colorPrimary">@color/primary_pink</item>
        <item name="colorSecondary">@color/secondary_pink</item>
    </style>


    <style name="Theme.AudioMixer" parent="Theme.AudioMixer.Default" />
</resources>